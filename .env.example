##############################################################################
# Database — PostgreSQL
##############################################################################
# DATABASE_URL is the POOLED connection used by the app at runtime.
# DIRECT_URL is the DIRECT connection, used only by `prisma migrate`.
# Both are required. Using the pooler for migrations will fail; using the
# direct connection at runtime will exhaust the connection limit under load.

# --- Local development (Postgres on your machine) ---
DATABASE_URL="postgresql://localhost:5432/ort_dev"
DIRECT_URL="postgresql://localhost:5432/ort_dev"

# --- Supabase ---
# Dashboard → Project Settings → Database → Connection string.
# Note the different ports: 6543 is the transaction pooler, 5432 is direct.
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

##############################################################################
# Auth
##############################################################################
# Sessions are database-backed; this secret is for cookie integrity.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="change-me"

##############################################################################
# Social login (optional) — Google & GitHub
##############################################################################
# Leave any provider's vars unset and its button simply doesn't appear.
# The callback URL you register must exactly match your origin, e.g.
#   http://localhost:3000/api/auth/google/callback   (local)
#   https://yourdomain.com/api/auth/google/callback   (production)
#
# Google  → console.cloud.google.com → APIs & Services → Credentials →
#           Create OAuth client ID → Web application. Add both callback URLs
#           above under "Authorized redirect URIs".
# GITHUB_… → github.com/settings/developers → New OAuth App. Set the
#           "Authorization callback URL" to …/api/auth/github/callback.
#
# GOOGLE_CLIENT_ID="…apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="…"
# GITHUB_CLIENT_ID="…"
# GITHUB_CLIENT_SECRET="…"

##############################################################################
# Email (optional) — Resend
##############################################################################
# Used for password-reset emails. Leave unset and emails are printed to the
# server console instead, so the flow is fully testable in development.
#
# 1. resend.com → Domains → add your domain, set the DKIM/SPF records it shows
#    at your DNS host, wait for "Verified".
# 2. resend.com → API Keys → create a key with "Sending access". The full key
#    (re_…) is shown ONCE at creation — copy it then.
# 3. EMAIL_FROM must use the verified domain.
#
# RESEND_API_KEY="re_…"
# EMAIL_FROM="Open Research Tunisia <noreply@openresearchtunisia.org>"

##############################################################################
# Activity digest cron (optional)
##############################################################################
# Secures the daily digest endpoint /api/cron/digest. On Vercel, set this and
# Vercel Cron sends it as a Bearer token automatically. Unset = endpoint open
# (fine locally). Generate with: openssl rand -hex 24
# CRON_SECRET="…"

##############################################################################
# File storage
##############################################################################
# Leave these unset to store uploads on local disk (./storage/uploads).
# That is fine for development and for a VPS with a persistent disk, but NOT
# for Vercel/Netlify — their filesystems are wiped on every deploy.
#
# Set all three to use Supabase Storage. Create a bucket named `resources` and
# keep it PRIVATE — the app issues short-lived signed URLs per download after
# checking the requester's permission.
#
# SUPABASE_URL="https://<ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"   # server-only, never expose to the browser
# SUPABASE_STORAGE_BUCKET="resources"
